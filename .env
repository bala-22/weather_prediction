# Weather Prediction Using Machine Learning - Environment Variables

# OpenWeatherMap API Key
WEATHER_API_KEY=c96008a42296eb46587c7b1519df6b1d

# Flask Configuration
FLASK_SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=true

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=weather_prediction

# Data Source: "openmeteo" for historical, "openweathermap" for current/forecast
DATA_SOURCE=openmeteo
DATA_MODE=openmeteo

# Rain Classification Threshold (mm)
RAIN_THRESHOLD=0.1

# Location Configuration
DEFAULT_LATITUDE=10.7905
DEFAULT_LONGITUDE=78.7047
DEFAULT_LOCATION=Tiruchirappalli
